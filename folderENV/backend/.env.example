# Copy file này thành .env và điền giá trị thật
# ================= Backend - Biến môi trường mẫu =================
NODE_ENV=development
PORT=3000
API_PREFIX=api

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

FRONTEND_URL=http://localhost:5173

JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_strong_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

PASSWORD_PEPPER=change_me_to_a_random_pepper
BCRYPT_ROUNDS=10

# Lưu ảnh đính kèm (ngoài public, đọc qua API có token)
UPLOAD_DIR=uploads
UPLOAD_BASE_PATH=uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=10

SEED_ADMIN_ACCOUNT=admin
SEED_ADMIN_EMAIL=admin@emd.local
SEED_ADMIN_PASSWORD=change_me_after_seed
